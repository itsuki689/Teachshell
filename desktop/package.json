{
  "name": "teachshelf-desktop",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "description": "课屿跨平台课程资料管理",
  "author": {
    "name": "Teachshelf contributors",
    "email": "codex@local.invalid"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build && node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:packaged": "node scripts/test-packaged.mjs",
    "release:mac": "node scripts/release-macos.mjs",
    "install:mac": "node scripts/install-macos.mjs",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "proper-lockfile": "^4.1.2",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  },
  "build": {
    "appId": "com.teachshelf.desktop",
    "productName": "Teachshell",
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/teaching-session-keychain"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "icon": "build-assets/icon.icns",
      "extraResources": [
        {
          "from": "dist-electron/teaching-session-keychain",
          "to": "teaching-session-keychain"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build-assets/icon.png",
      "syncDesktopName": true,
      "maintainer": "Teachshelf contributors <codex@local.invalid>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null,
    "toolsets": {
      "nsis": "1.2.1",
      "appimage": "1.0.3"
    },
    "deb": {
      "compression": "gz"
    },
    "extraResources": [
      {
        "from": "dist-electron/mcp-stdio.cjs",
        "to": "mcp-stdio.cjs"
      }
    ],
    "beforePack": "scripts/before-pack.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "com.teachshelf.desktop.desktop",
  "homepage": "https://github.com/itsuki689/Teachshell"
}
